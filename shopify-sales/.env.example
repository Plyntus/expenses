# Credentials for opening the dashboard. Use a unique password, 16+ characters.
DASHBOARD_USERNAME=ros
DASHBOARD_PASSWORD=

# Shopify app in the same organization as this store; read_orders + read_products.
SHOPIFY_SHOP=flipper-zero.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional alternative for an existing app with a non-expiring Admin API token.
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10

DASHBOARD_TIMEZONE=Europe/Belgrade
HISTORY_DAYS=30
POLL_SECONDS=60
DATABASE_PATH=/data/sales.sqlite3
